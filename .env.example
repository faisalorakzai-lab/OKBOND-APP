# Optional public Polygon Mainnet JSON-RPC endpoint override.
# A public RPC URL is bundled into client requests; it is not a secret.
# Do not put private keys, seed phrases, server credentials, or privileged API secrets here.
EXPO_PUBLIC_POLYGON_RPC_URL=

# Optional OAuth portal configuration. Required to activate the secure callback flow.
# Never put provider client secrets in EXPO_PUBLIC_* values.
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_API_BASE_URL=

# Supabase Auth public client configuration. The anon/publishable key is safe for the client;
# never put a Supabase service-role key or wallet private key in EXPO_PUBLIC_* values.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Reown/WalletConnect project ID is public client configuration, not a wallet private key.
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Development-only local preview account. Keep false/empty in production builds.
EXPO_PUBLIC_TESTNET_PREVIEW=
