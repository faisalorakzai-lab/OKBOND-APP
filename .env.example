# Optional public Polygon Mainnet JSON-RPC endpoint override.
# A public RPC URL is bundled into client requests; it is not a secret.
# Do not put private keys, seed phrases, server credentials, or privileged API secrets here.
EXPO_PUBLIC_POLYGON_RPC_URL=

# Optional OAuth portal configuration. Required to activate the secure callback flow.
# Never put provider client secrets in EXPO_PUBLIC_* values.
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_API_BASE_URL=
